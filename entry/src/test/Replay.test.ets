// Suite: Replay.test - replay integration test (task A11): the recorded Demo walk track drives the real pipeline.
// Owner: task A11 (Person A). Registered in List.test.ets by T1 (do not rename the exported function).
//
// Fixture: fixtures/DemoTrackMini.ets (SIMULATED, generated by `node scripts/demo/make-demo-walk.mjs --fixture`):
// the last five stops of the Royal Route demo walk (7 St Adalbert's, 8 Sts Peter and Paul, 9 St Andrew's = pass-by,
// 10 Kanonicza, 11 Wawel), with the ~80 m detour (track 195-250 s) and the 10 s accuracy dip to 60 m (862-871 s).
//
// Layer 1 (pure core, deterministic, no timers): Planner (Held-Karp) -> DemoWalkPlayer (hold while a story plays,
// like DemoWalkSource) -> TourEngine (which runs FixFilter on every fix) with a fake clock and a fake speech engine
// that needs 2.5 s per sentence. An independent FixFilter classifies the same fixes as a probe.
// Runs: voice x1 (track time), voice x4 and x8 (wall-clock stamps, as on the emulator), text-only x1 (TICK pacing).
// Layer 2: the same track through the real TourController (fake ports: manual clock + scheduler, pack, speech,
// a demo source that wraps DemoWalkPlayer exactly like DemoWalkSource) at x8, the DevPanel "Start demo tour" flow.
//
// Jury-relevant outcomes asserted: every planned stop entered exactly once and in the planned order; full story at
// the dwell stops and teaser only at the pass-by stop, at x1 (real walking pace) as well as x8; no story cut mid-sentence (no STOP_SPEECH, no overlapping
// sentence, every item completes, a stop's story is never interleaved with another); finished state; no arrival
// during the detour or the 60 m accuracy window.
// A9 (turn-by-turn, off-route): the fixture carries the pack's legs between the fixture stops (routes.json, the track
// walks them), so the engine tracks every leg: spoken turn cues fire on the walk (NAV_CUE kind=now, each cue once);
// the ~80 m detour gives exactly one OFF_ROUTE inside its window (also at x4/x8 with wall-clock stamps), then
// REQUEST_REPLAN -> Planner from the current fix -> PLAN_READY (REPLAN changed=0) and ON_ROUTE once the walker is
// back; nowhere else on the normal track is the walker off the route (no false positive).
// Each run prints one `REPLAY_SUMMARY ...` line (pasted into the README "Testing" section and the A11 PR).
import { describe, it, expect } from '@ohos/hypium';
import { StepResult, TourEngine, TourInput, TourState } from '../main/ets/core/tour/TourEngine';
import { TourConfig } from '../main/ets/core/tour/TourConfig';
import { FilteredFix, FixFilter } from '../main/ets/core/geo/FixFilter';
import { CityPack, PlanInputs, buildCostInputs, plan as planRoute } from '../main/ets/core/route/Planner';
import { DemoFix, DemoTick, DemoTrack, DemoWalkPlayer } from '../main/ets/core/sim/DemoWalkPlayer';
import {
  Effect, EffectType, EngineEvent, EngineEventType, EngineSnapshot, StopProgress, StopStatus, TourPhase, TourPlan
} from '../main/ets/contracts/EngineTypes';
import {
  BackgroundPort, Clock, Fix, FixListener, FixSource, HapticsPort, LocationErrorListener, LocationSource, LoggerPort,
  MediaSessionPort, NotifierPort, PackLoadResult, PackRepository, PermissionPort, SpeechCapabilities, SpeechListener,
  SpeechPort, Utterance, VoicePlan, VoicePort, VoiceState
} from '../main/ets/contracts/Ports';
import {
  ContentTier, Lang, LatLng, MapData, Narration, NarrationLength, PackManifest, Persona, Poi, PoiKind,
  ProvenanceKind, RouteData, SourceRef, Tour, TourStop
} from '../main/ets/contracts/Model';
import { EnVoiceStrategy, VoiceLabel } from '../main/ets/contracts/Settings';
import { DemoControls, TourController, TourControllerDeps } from '../main/ets/services/tour/TourController';
import { Scheduler } from '../main/ets/app/Clock';
import {
  DEMO_MINI_DIST_M, DEMO_MINI_DUR_S, DEMO_MINI_EVENTS, DEMO_MINI_STOPS, MiniEvent, MiniStop, demoMiniLegs,
  demoTrackMini
} from './fixtures/DemoTrackMini';

const T0: number = 1700000000000;
const SENTENCE_MS: number = 2500;          // fake speech: every sentence takes 2.5 s
const MAX_STEPS: number = 6000;            // 1 s steps; the x1 walk needs ~1250
const PERSONA: string = 'historian';
const TOUR_ID: string = 'royal-route-mini';
const PASS_BY_STOP: number = 9;
/** An arrival may be confirmed at most this long (track time) after the walker leaves the stop's dwell. */
const ARRIVAL_SLACK_MS: number = 10000;
/** Off-route may start/clear this long (track time) around the detour window (fixes > 35 m off the leg). */
const OFF_ROUTE_SLACK_MS: number = 30000;
/*
 * Walking pace (issue #60, fixed in core/tour). At x1 the 35 m geofence (+15 m accuracy allowance) is entered
 * ~25-50 s before the walker reaches a stop, so this fixture's short teaser (arrival line + 2 sentences x 2.5 s) ends
 * while the walker is still approaching. The engine then waits in silence (LINGER, `STORY_LINGER action=wait`) and
 * decides on a later fix: full once the walker has stood still for 4 s (dwell stops 8, 10, 11), teaser only once
 * they have got no closer for 20 s or walked 15 m past (pass-by stop 9, which has a 3 s slow-down at the corner).
 * Before the fix the x1 runs gave dwell stops 8, 10 and 11 only the teaser (x4: 10 and 11); now every run asserts
 * the same outcome.
 */

// ---------------------------------------------------------------- pack built from the fixture stops

/** The pack POI of fixture stop n (the stops are the real Royal Route POIs, the legs the pack's). */
function poiId(n: number): string {
  const s: MiniStop | undefined = DEMO_MINI_STOPS.find((m: MiniStop) => m.n === n);
  return s === undefined ? `poi_demo_stop_${n}` : s.poiId;
}

function stopOf(id: string): MiniStop | undefined {
  return DEMO_MINI_STOPS.find((s: MiniStop) => poiId(s.n) === id);
}

function stopIds(): string[] {
  return DEMO_MINI_STOPS.map((s: MiniStop) => poiId(s.n));
}

function eventOf(kind: string): MiniEvent {
  return DEMO_MINI_EVENTS.find((e: MiniEvent) => e.kind === kind) as MiniEvent;
}

function packPois(): Poi[] {
  const out: Poi[] = [];
  for (const s of DEMO_MINI_STOPS) {
    const p: Poi = {
      id: poiId(s.n), kind: PoiKind.CHURCH, lat: s.lat, lng: s.lng, x: 0, y: 0, names: { en: s.name, pl: s.name },
      importance: 1, tier: ContentTier.REVIEWED_HISTORIAN, triggerRadiusM: 35, sourceIds: ['src_test']
    };
    out.push(p);
  }
  return out;
}

function packTour(): Tour {
  const stops: TourStop[] = DEMO_MINI_STOPS.map((s: MiniStop) => {
    const ts: TourStop = { poiId: poiId(s.n), dwellS: 60, prize: 3 };
    return ts;
  });
  const t: Tour = {
    id: TOUR_ID, personaId: PERSONA, titles: { en: 'Royal Route (stops 7-11)' }, summaries: { en: 'Replay fixture' },
    stops: stops, fixedStartPoiId: poiId(DEMO_MINI_STOPS[0].n),
    fixedEndPoiId: poiId(DEMO_MINI_STOPS[DEMO_MINI_STOPS.length - 1].n), estMinutes: 20
  };
  return t;
}

/** The pack's walking matrix and legs between the fixture stops (routes.json, written into the fixture). */
function packRoutes(): RouteData {
  const r: RouteData = {
    nodeIds: stopIds(), distancesM: DEMO_MINI_DIST_M, durationsS: DEMO_MINI_DUR_S, detourFactor: 1.25,
    legs: demoMiniLegs()
  };
  return r;
}

function teaserText(n: number, i: number): string {
  return `Stop ${n} teaser sentence ${i}.`;
}

function fullText(n: number, i: number): string {
  return `Stop ${n} full sentence ${i}.`;
}

function narration(s: MiniStop, len: NarrationLength): Narration {
  const sentences: string[] = [];
  const count: number = len === NarrationLength.TEASER ? 2 : 3;
  for (let i = 1; i <= count; i++) {
    sentences.push(len === NarrationLength.TEASER ? teaserText(s.n, i) : fullText(s.n, i));
  }
  const n: Narration = {
    id: `${poiId(s.n)}:${PERSONA}:en:${len}`, poiId: poiId(s.n), personaId: PERSONA, lang: Lang.EN, length: len,
    sentences: sentences, tier: ContentTier.REVIEWED_HISTORIAN, sources: ['src_test'], claims: [],
    generatedBy: { kind: ProvenanceKind.HUMAN, at: '2026-10-03T00:00:00Z' },
    validation: { status: 'pass', checks: ['fixture'], validatorVersion: 1 }
  };
  return n;
}

function narrationLookup(poi: string, len: NarrationLength): Narration | undefined {
  const s: MiniStop | undefined = stopOf(poi);
  if (s === undefined || len === NarrationLength.DEEP) {
    return undefined;
  }
  return narration(s, len);
}

function voicePlan(text: boolean): VoicePlan {
  const v: VoicePlan = {
    textLang: Lang.EN, speechMode: text ? 'text' : 'voice', engineLocale: text ? '' : 'zh-CN', person: text ? 0 : 13,
    languageContext: text ? '' : 'en-US', label: text ? VoiceLabel.TEXT_ONLY_USER : VoiceLabel.FALLBACK_ZH_READS_EN,
    reason: 'replay'
  };
  return v;
}

function invalidOrigin(): LatLng {
  const o: LatLng = { lat: Number.NaN, lng: Number.NaN };
  return o;
}

/** The real planner on the fixture pack, from the tour's own start (as on the emulator: Beijing is out of area). */
function heldKarpPlan(): TourPlan {
  const pack: CityPack = { pois: packPois(), routes: packRoutes() };
  const inputs: PlanInputs = buildCostInputs(pack, packTour(), stopIds(), invalidOrigin());
  return planRoute(inputs, 0);
}

// ---------------------------------------------------------------- observations shared by both layers

class LogLine {
  code: string;
  kv: string;
  trackMs: number;      // track time of the sample the walker was on when the line was logged

  constructor(code: string, kv: string, trackMs: number) {
    this.code = code;
    this.kv = kv;
    this.trackMs = trackMs;
  }
}

/** One sentence the user heard (voice) or read (text-only caption). */
class Heard {
  id: string;
  itemId: string;
  index: number;
  text: string;

  constructor(u: Utterance) {
    this.id = u.id;
    this.itemId = u.itemId;
    const rest: string = u.id.substring(u.itemId.length + 1);
    const hash: number = rest.indexOf('#');
    this.index = parseInt(hash >= 0 ? rest.substring(0, hash) : rest, 10);
    this.text = u.text;
  }
}

function kvOf(kv: string, key: string): string {
  for (const part of kv.split(' ')) {
    if (part.indexOf(`${key}=`) === 0) {
      return part.substring(key.length + 1);
    }
  }
  return '';
}

function inWindow(ms: number, e: MiniEvent): boolean {
  return ms >= e.fromMs && ms <= e.toMs;
}

function stopNumber(id: string): string {
  const s: MiniStop | undefined = stopOf(id);
  return s === undefined ? '?' : `${s.n}`;
}

class Observed {
  logs: LogLine[] = [];
  heard: Heard[] = [];
  violations: string[] = [];
  stopSpeech: number = 0;
  replanRequests: number = 0;
  offRouteSnapshots: number = 0;
  demoHoldSeen: boolean = false;
  probeFixes: number = 0;
  probeTriggerGrade: number = 0;
  probePoorInWindow: number = 0;
  probeFixesInWindow: number = 0;

  lines(code: string): LogLine[] {
    return this.logs.filter((l: LogLine) => l.code === code);
  }

  count(code: string, part: string): number {
    return this.lines(code).filter((l: LogLine) => l.kv.indexOf(part) >= 0).length;
  }

  enteredIds(): string[] {
    return this.lines('POI_ENTER').map((l: LogLine) => kvOf(l.kv, 'id'));
  }

  /** POI ids that got a FULL_STORY item (the engine's "linger => full" decision). */
  fullStoryIds(): string[] {
    return this.lines('STORY_QUEUE').filter((l: LogLine) => kvOf(l.kv, 'kind') === 'fullStory')
      .map((l: LogLine) => kvOf(l.kv, 'poi'));
  }

  teaserOnlyIds(): string[] {
    return this.lines('STORY_SKIP_MOVING').map((l: LogLine) => kvOf(l.kv, 'poi'));
  }

  /** NAV_CUE lines of spoken-style cues (not the snap lines). */
  navCues(kind: string): LogLine[] {
    return this.lines('NAV_CUE').filter((l: LogLine) => kvOf(l.kv, 'kind') === kind);
  }

  /** A fix accepted by the probe FixFilter (same thresholds the engine applies). */
  probe(r: FilteredFix, trackMs: number): void {
    this.probeFixes++;
    if (r.triggerGrade) {
      this.probeTriggerGrade++;
    }
    if (inWindow(trackMs, eventOf('poorAccuracy'))) {
      this.probeFixesInWindow++;
      if (!r.triggerGrade) {
        this.probePoorInWindow++;
      }
    }
  }

  /** Checks that every started item was heard completely, sentence by sentence, without interleaving. */
  checkSentences(): void {
    const queued: Map<string, number> = new Map<string, number>();
    for (const l of this.lines('STORY_QUEUE')) {
      queued.set(kvOf(l.kv, 'id'), parseInt(kvOf(l.kv, 'n'), 10));
    }
    const nextIdx: Map<string, number> = new Map<string, number>();
    let open: string = '';
    for (const h of this.heard) {
      const expected: number = nextIdx.has(h.itemId) ? nextIdx.get(h.itemId) as number : 0;
      if (h.index !== expected) {
        this.violations.push(`item ${h.itemId}: sentence ${h.index} heard, expected ${expected}`);
      }
      if (open.length > 0 && open !== h.itemId) {
        this.violations.push(`item ${open} cut by ${h.itemId}`);
      }
      nextIdx.set(h.itemId, h.index + 1);
      const n: number = queued.has(h.itemId) ? queued.get(h.itemId) as number : -1;
      open = h.index + 1 < n ? h.itemId : '';
    }
    nextIdx.forEach((done: number, item: string) => {
      const n: number = queued.has(item) ? queued.get(item) as number : -1;
      if (done !== n) {
        this.violations.push(`item ${item}: ${done} of ${n} sentences heard`);
      }
    });
    for (const l of this.lines('STORY_START')) {
      const id: string = kvOf(l.kv, 'id');
      if (this.count('STORY_END', `id=${id} `) !== 1) {
        this.violations.push(`item ${id}: no single STORY_END`);
      }
    }
    if (this.count('STORY_END', 'skipped=true') > 0) {
      this.violations.push('an item was skipped');
    }
  }

  summary(name: string, finished: boolean, wallS: number): string {
    const enters: string = this.lines('POI_ENTER').map((l: LogLine) =>
    `${stopNumber(kvOf(l.kv, 'id'))}@${Math.round(l.trackMs / 1000)}s`).join(',');
    return `REPLAY_SUMMARY run=${name} enter=[${enters}] full=[${this.fullStoryIds().map(stopNumber).join(',')}] ` +
      `teaserOnly=[${this.teaserOnlyIds().map(stopNumber).join(',')}] sentences=${this.heard.length} ` +
      `stories=${this.lines('STORY_START').length} violations=${this.violations.length} ` +
      `stopSpeech=${this.stopSpeech} replan=${this.lines('REPLAN').length} offRoute=${this.lines('OFF_ROUTE')
        .map((l: LogLine) => `${Math.round(l.trackMs / 1000)}s`).join(',')} navNow=${this.navCues('now').length} ` +
      `navPrepare=${this.navCues('prepare').length} ` +
      `offRouteSnaps=${this.offRouteSnapshots} locPoor=${this.lines('LOC_POOR').length} ` +
      `triggerGrade=${this.probeTriggerGrade}/${this.probeFixes} poorInDip=${this.probePoorInWindow}/` +
      `${this.probeFixesInWindow} finished=${finished} simulatedS=${wallS}`;
  }
}

// ---------------------------------------------------------------- layer 1: pure engine replay

class EngineReplay {
  readonly text: boolean;
  readonly speed: number;
  readonly trackStamps: boolean;      // true: fix timestamps = track time (x1); false: wall clock (DemoWalkSource)
  readonly track: DemoTrack = demoTrackMini();
  readonly player: DemoWalkPlayer;
  readonly probe: FixFilter = new FixFilter();
  readonly obs: Observed = new Observed();
  st: TourState;
  plan: TourPlan;
  t: number = T0;
  trackMs: number = 0;
  inFlight: Utterance | undefined = undefined;
  dueMs: number = 0;
  ended: boolean = false;
  steps: number = 0;
  private lastShown: string = '';

  constructor(text: boolean, speed: number, trackStamps: boolean) {
    this.text = text;
    this.speed = speed;
    this.trackStamps = trackStamps;
    this.player = new DemoWalkPlayer(this.track);
    this.player.reset(T0);
    const input: TourInput = {
      tour: packTour(), pois: packPois(), lang: Lang.EN, personaId: PERSONA,
      narration: (id: string, len: NarrationLength): Narration | undefined => narrationLookup(id, len),
      voice: voicePlan(text), adaptiveLength: true, spokenDirections: true, source: FixSource.DEMO,
      legs: demoMiniLegs()
    };
    this.st = TourEngine.init(input, new TourConfig());
    this.plan = heldKarpPlan();
  }

  /** REQUEST_REPLAN, as TourController.replan(): the planner over the open stops from the current fix. */
  replan(nowMs: number): void {
    const open: string[] = TourEngine.snapshot(this.st).stops
      .filter((s: StopProgress) => s.status === StopStatus.PENDING || s.status === StopStatus.APPROACHING)
      .map((s: StopProgress) => s.poiId);
    const f: Fix | undefined = this.st.lastFix;
    const origin: LatLng = f === undefined ? invalidOrigin() : { lat: f.lat, lng: f.lng };
    const pack: CityPack = { pois: packPois(), routes: packRoutes() };
    const p: TourPlan = planRoute(buildCostInputs(pack, packTour(), open, origin), 0);
    const ev: EngineEvent = { type: EngineEventType.PLAN_READY, nowMs: nowMs, plan: p };
    this.dispatch(ev);
  }

  /** "A story is playing" (TourController.storyActive), the Demo walk hold predicate. */
  storyActive(): boolean {
    return this.st.phase === TourPhase.AT_STOP && this.st.activeIdx >= 0;
  }

  dispatch(ev: EngineEvent): void {
    const r: StepResult = TourEngine.reduce(this.st, ev);
    this.st = r.state;
    let replan: boolean = false;
    for (const fx of r.effects) {
      this.execute(fx, ev.nowMs);
      replan = replan || fx.type === EffectType.REQUEST_REPLAN;
    }
    if (replan) {
      this.replan(ev.nowMs);
    }
    if (this.text) {
      const u: Utterance | undefined = this.st.queue.inFlight();
      if (u !== undefined && u.id !== this.lastShown) {
        this.lastShown = u.id;
        this.obs.heard.push(new Heard(u));
      }
    }
    const snap: EngineSnapshot = TourEngine.snapshot(this.st);
    if (snap.offRoute) {
      this.obs.offRouteSnapshots++;
    }
  }

  execute(fx: Effect, nowMs: number): void {
    switch (fx.type) {
      case EffectType.SPEAK:
        if (fx.utterance !== undefined) {
          if (this.text) {
            this.obs.violations.push(`SPEAK in text-only mode: ${fx.utterance.id}`);
          }
          if (this.inFlight !== undefined) {
            this.obs.violations.push(`SPEAK ${fx.utterance.id} while ${this.inFlight.id} is still speaking`);
          }
          this.inFlight = fx.utterance;
          this.dueMs = nowMs + SENTENCE_MS;
          this.obs.heard.push(new Heard(fx.utterance));
        }
        break;
      case EffectType.STOP_SPEECH:
        this.obs.stopSpeech++;
        if (fx.afterCurrent !== true && this.inFlight !== undefined) {
          this.obs.violations.push(`STOP_SPEECH cut ${this.inFlight.id}`);
          this.inFlight = undefined;
        }
        break;
      case EffectType.REQUEST_REPLAN:
        this.obs.replanRequests++;
        break;
      case EffectType.LOG:
        this.obs.logs.push(new LogLine(fx.logCode === undefined ? '' : fx.logCode,
          fx.logKv === undefined ? '' : fx.logKv, this.trackMs));
        break;
      default:
        break;
    }
  }

  simple(type: EngineEventType, nowMs: number): EngineEvent {
    const ev: EngineEvent = { type: type, nowMs: nowMs };
    return ev;
  }

  idle(): boolean {
    return !this.st.queue.isBusy() && this.st.queue.size() === 0;
  }

  run(): EngineReplay {
    this.dispatch(this.simple(EngineEventType.START_PLANNING, this.t));
    const ready: EngineEvent = { type: EngineEventType.PLAN_READY, nowMs: this.t, plan: this.plan };
    this.dispatch(ready);
    this.dispatch(this.simple(EngineEventType.START_TOUR, this.t));
    for (this.steps = 0; this.steps < MAX_STEPS; this.steps++) {
      this.t += 1000;
      while (this.inFlight !== undefined && this.dueMs <= this.t) {
        const done: EngineEvent = {
          type: EngineEventType.UTTERANCE_DONE, nowMs: this.dueMs, utteranceId: this.inFlight.id
        };
        this.inFlight = undefined;
        this.dispatch(done);
      }
      this.dispatch(this.simple(EngineEventType.TICK, this.t));
      if (!this.ended) {
        const tick: DemoTick = this.player.tick(1000 * this.speed, this.storyActive());
        this.ended = tick.ended;
        this.trackMs = this.track.fixes[tick.index].tRelMs;
        const f: Fix = tick.fix;
        if (!this.trackStamps) {
          f.timestampMs = this.t;            // DemoWalkSource default: wall-clock stamps
        }
        this.obs.probe(this.probe.accept(f), this.trackMs);
        const ev: EngineEvent = { type: EngineEventType.FIX, nowMs: f.timestampMs, fix: f };
        this.dispatch(ev);
      }
      if (this.st.phase === TourPhase.FINISHED && this.idle() && this.inFlight === undefined) {
        break;
      }
    }
    this.obs.checkSentences();
    return this;
  }

  statusOf(id: string): StopStatus | undefined {
    const p: StopProgress | undefined = TourEngine.snapshot(this.st).stops.find((s: StopProgress) => s.poiId === id);
    return p === undefined ? undefined : p.status;
  }

  summary(name: string): string {
    return this.obs.summary(name, this.st.phase === TourPhase.FINISHED, this.steps);
  }
}

/** The assertions every run must pass (both speech modes, both speeds, both layers). */
function assertJuryOutcomes(obs: Observed, finalStatus: (id: string) => StopStatus | undefined): void {
  // every planned stop entered exactly once, in the planned order
  expect(obs.enteredIds().join(',')).assertEqual(stopIds().join(','));
  // each arrival on the right stretch of the walk (after leaving the previous stop, before leaving this one);
  // none during the detour or the accuracy dip
  for (const l of obs.lines('POI_ENTER')) {
    const s: MiniStop = stopOf(kvOf(l.kv, 'id')) as MiniStop;
    const i: number = DEMO_MINI_STOPS.indexOf(s);
    const after: number = i > 0 ? DEMO_MINI_STOPS[i - 1].departMs : -1;
    expect(l.trackMs > after && l.trackMs <= s.departMs + ARRIVAL_SLACK_MS).assertTrue();
    expect(inWindow(l.trackMs, eventOf('detour'))).assertFalse();
    expect(inWindow(l.trackMs, eventOf('poorAccuracy'))).assertFalse();
  }
  // story length decisions: teaser only at the pass-by stop; full at every dwell stop (at x1 too, issue #60)
  const dwell: string[] = DEMO_MINI_STOPS.filter((s: MiniStop) => s.mode === 'dwell').map((s: MiniStop) => poiId(s.n));
  const full: string[] = obs.fullStoryIds();
  const teaserOnly: string[] = obs.teaserOnlyIds();
  expect(teaserOnly.indexOf(poiId(PASS_BY_STOP)) >= 0).assertTrue();
  expect(full.indexOf(poiId(PASS_BY_STOP)) < 0).assertTrue();
  expect(full.indexOf(dwell[0]) >= 0).assertTrue();          // the start stop: the walker is already standing there
  expect(full.length + teaserOnly.length).assertEqual(DEMO_MINI_STOPS.length);   // one decision per stop
  expect(full.join(',')).assertEqual(dwell.join(','));
  expect(teaserOnly.join(',')).assertEqual(poiId(PASS_BY_STOP));
  for (const id of stopIds()) {
    expect(finalStatus(id)).assertEqual(teaserOnly.indexOf(id) >= 0 ? StopStatus.TEASER_ONLY : StopStatus.VISITED);
  }
  // no story interrupted mid-sentence
  expect(obs.violations.join(' | ')).assertEqual('');
  expect(obs.stopSpeech).assertEqual(0);
  expect(obs.lines('STORY_START').length > 0).assertTrue();
  // every teaser was heard to its last sentence; the full story to its last sentence exactly at the dwell stops
  for (const s of DEMO_MINI_STOPS) {
    expect(obs.heard.some((h: Heard) => h.text === teaserText(s.n, 2))).assertTrue();
    expect(obs.heard.some((h: Heard) => h.text === fullText(s.n, 3))).assertEqual(full.indexOf(poiId(s.n)) >= 0);
  }
  // finished (exactly one engine transition; the controller's TEARDOWN line is from=finished)
  expect(obs.lines('STATE').filter((l: LogLine) => kvOf(l.kv, 'to') === 'finished' && kvOf(l.kv, 'from') !== 'finished')
    .length).assertEqual(1);
  // no lost-GPS episode
  expect(obs.lines('LOC_LOST').length).assertEqual(0);
  assertTurnByTurn(obs);
  // the 60 m accuracy dip: every fix there is not trigger-grade (probe FixFilter), and the engine logs LOC_POOR
  expect(obs.probeFixesInWindow > 0).assertTrue();
  expect(obs.probePoorInWindow).assertEqual(obs.probeFixesInWindow);
  expect(obs.lines('LOC_POOR').some((l: LogLine) => inWindow(l.trackMs, eventOf('poorAccuracy')))).assertTrue();
}

/**
 * A9: turn cues fire on the walk, each once; the injected ~80 m detour (and only it) is OFF_ROUTE -> REPLAN ->
 * ON_ROUTE. Holds for every run (x1 track stamps, x4/x8 wall-clock stamps, text-only, the controller).
 */
function assertTurnByTurn(obs: Observed): void {
  const now: LogLine[] = obs.navCues('now');
  expect(now.length >= 4).assertTrue();
  const keys: string[] = obs.lines('NAV_CUE').filter((l: LogLine) => kvOf(l.kv, 'kind') !== 'snap')
    .map((l: LogLine) => `${kvOf(l.kv, 'leg')}:${kvOf(l.kv, 'step')}:${kvOf(l.kv, 'kind')}`);
  expect(new Set<string>(keys).size).assertEqual(keys.length);              // every cue once
  expect(obs.lines('NAV_CUE').every((l: LogLine) => kvOf(l.kv, 'src') === 'demo')).assertTrue();
  expect(obs.lines('NAV_CUE').filter((l: LogLine) => kvOf(l.kv, 'kind') !== 'snap')
    .every((l: LogLine) => kvOf(l.kv, 'spoken') === '1')).assertTrue();
  // a turn cue was really said (or captioned) to the end
  expect(obs.heard.some((h: Heard) => h.text.indexOf('Now ') === 0)).assertTrue();
  // the detour: exactly one off-route episode, inside its window, then the re-plan, then back on the route
  const det: MiniEvent = eventOf('detour');
  const off: LogLine[] = obs.lines('OFF_ROUTE');
  expect(off.length).assertEqual(1);
  expect(off[0].trackMs >= det.fromMs && off[0].trackMs <= det.toMs).assertTrue();
  expect(kvOf(off[0].kv, 'leg')).assertEqual(`${poiId(7)}>${poiId(8)}`);
  expect(kvOf(off[0].kv, 'src')).assertEqual('demo');
  expect(inOrder(obs, [['OFF_ROUTE', 'leg='], ['REPLAN', 'changed=0'], ['ON_ROUTE', 'leg=']]) >= 0).assertTrue();
  const re: LogLine[] = obs.lines('REPLAN');
  expect(re.length).assertEqual(1);
  expect(kvOf(re[0].kv, 'to')).assertEqual(poiId(8));
  const on: LogLine[] = obs.lines('ON_ROUTE');
  expect(on.length).assertEqual(1);
  expect(on[0].trackMs >= det.fromMs && on[0].trackMs <= det.toMs + OFF_ROUTE_SLACK_MS).assertTrue();
  expect(obs.offRouteSnapshots > 0).assertTrue();
  expect(obs.heard.some((h: Heard) => h.text === 'You\'ve left the route.')).assertTrue();
}

/**
 * x1 only (issue #60): the teaser ended before the walker reached dwell stops 8, 10 and 11, so the engine waited
 * (LINGER) and switched to the full story only once the walker stood still there; stop 9 was decided by walking on.
 */
function assertWalkingPaceLinger(obs: Observed): void {
  const waited: string[] = obs.lines('STORY_LINGER').filter((l: LogLine) => kvOf(l.kv, 'action') === 'wait')
    .map((l: LogLine) => stopNumber(kvOf(l.kv, 'poi')));
  expect(waited.join(',')).assertEqual('8,9,10,11');
  const stillFull: string[] = obs.lines('STORY_LINGER')
    .filter((l: LogLine) => kvOf(l.kv, 'action') === 'full' && kvOf(l.kv, 'reason') === 'still')
    .map((l: LogLine) => stopNumber(kvOf(l.kv, 'poi')));
  expect(stillFull.join(',')).assertEqual('8,10,11');
  for (const l of obs.lines('STORY_LINGER')) {
    if (kvOf(l.kv, 'action') === 'full') {     // the full story starts at the stop, not on the approach
      const s: MiniStop = stopOf(kvOf(l.kv, 'poi')) as MiniStop;
      expect(l.trackMs >= s.arrivalMs && l.trackMs <= s.departMs).assertTrue();
    }
  }
  const skip: LogLine[] = obs.lines('STORY_SKIP_MOVING');
  expect(skip.length).assertEqual(1);
  expect(['window', 'receding', 'exited'].indexOf(kvOf(skip[0].kv, 'reason')) >= 0).assertTrue();
}

// ---------------------------------------------------------------- layer 2: TourController with fake ports

class ManualClock implements Clock {
  t: number = T0;

  nowMs(): number {
    return this.t;
  }
}

class Job {
  id: number;
  at: number;
  period: number;
  fn: () => void;

  constructor(id: number, at: number, period: number, fn: () => void) {
    this.id = id;
    this.at = at;
    this.period = period;
    this.fn = fn;
  }
}

class ManualScheduler implements Scheduler {
  private clock: ManualClock;
  private jobs: Job[] = [];
  private seq: number = 0;

  constructor(clock: ManualClock) {
    this.clock = clock;
  }

  after(ms: number, fn: () => void): number {
    this.seq++;
    this.jobs.push(new Job(this.seq, this.clock.t + Math.max(0, ms), 0, fn));
    return this.seq;
  }

  every(ms: number, fn: () => void): number {
    this.seq++;
    this.jobs.push(new Job(this.seq, this.clock.t + ms, ms, fn));
    return this.seq;
  }

  cancel(id: number): void {
    this.jobs = this.jobs.filter((j: Job) => j.id !== id);
  }

  count(): number {
    return this.jobs.length;
  }

  /** Fires every job due within `ms`, in time order (ties by creation), moving the clock along. */
  advance(ms: number): void {
    const end: number = this.clock.t + ms;
    for (let guard = 0; guard < 100000; guard++) {
      let next: Job | undefined = undefined;
      for (const j of this.jobs) {
        if (j.at <= end && (next === undefined || j.at < next.at || (j.at === next.at && j.id < next.id))) {
          next = j;
        }
      }
      if (next === undefined) {
        break;
      }
      const due: Job = next;
      this.clock.t = Math.max(this.clock.t, due.at);
      if (due.period > 0) {
        due.at += due.period;
      } else {
        this.jobs = this.jobs.filter((j: Job) => j.id !== due.id);
      }
      due.fn();
    }
    this.clock.t = end;
  }
}

/** LoggerPort that records `EVENT k=v` lines with the track time of the demo walker. */
class RecordingLog implements LoggerPort {
  readonly obs: Observed;
  trackMs: () => number = () => 0;

  constructor(obs: Observed) {
    this.obs = obs;
  }

  info(event: string, kv: string): void {
    this.obs.logs.push(new LogLine(event, kv, this.trackMs()));
  }

  warn(event: string, kv: string): void {
    this.info(event, kv);
  }

  error(event: string, kv: string): void {
    this.info(event, kv);
  }
}

class ReplaySpeech implements SpeechPort {
  private readonly sched: ManualScheduler;
  private readonly obs: Observed;
  private listener: SpeechListener | undefined = undefined;
  private inFlight: Utterance | undefined = undefined;

  constructor(sched: ManualScheduler, obs: Observed) {
    this.sched = sched;
    this.obs = obs;
  }

  init(): Promise<SpeechCapabilities> {
    const c: SpeechCapabilities = { en: VoiceState.DOWNLOADABLE, zh: VoiceState.INSTALLED };
    return Promise.resolve(c);
  }

  setListener(l: SpeechListener): void {
    this.listener = l;
  }

  speak(u: Utterance): void {
    if (this.inFlight !== undefined) {
      this.obs.violations.push(`speak ${u.id} while ${this.inFlight.id} is still speaking`);
    }
    this.inFlight = u;
    this.obs.heard.push(new Heard(u));
    const l: SpeechListener | undefined = this.listener;
    if (l === undefined) {
      return;
    }
    l.onUtteranceStart(u.id);
    const id: string = u.id;
    this.sched.after(SENTENCE_MS, () => {
      if (this.inFlight !== undefined && this.inFlight.id === id) {
        this.inFlight = undefined;
        l.onUtteranceDone(id);
      }
    });
  }

  prefetch(u: Utterance): void {
  }

  stopNow(): void {
    this.obs.stopSpeech++;
    if (this.inFlight !== undefined) {
      this.obs.violations.push(`stopNow cut ${this.inFlight.id}`);
    }
    this.inFlight = undefined;
  }

  pause(): void {
  }

  resume(): void {
  }

  isSpeaking(): boolean {
    return this.inFlight !== undefined;
  }
}

