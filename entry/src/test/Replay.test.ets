/** DemoWalkSource without @kit: a 1 s timer, DemoWalkPlayer at the chosen speed, wall-clock stamps, hold predicate. */
class ReplayDemoSource implements LocationSource, DemoControls {
  readonly kind: FixSource = FixSource.DEMO;
  readonly track: DemoTrack = demoTrackMini();
  private readonly player: DemoWalkPlayer;
  private readonly sched: ManualScheduler;
  private readonly clock: ManualClock;
  private readonly probe: FixFilter = new FixFilter();
  private readonly obs: Observed;
  private timer: number = -1;
  private mult: number = 1;
  private hold: () => boolean = () => false;
  private holding: boolean = false;
  private ended: boolean = false;
  trackMs: number = 0;

  constructor(sched: ManualScheduler, clock: ManualClock, obs: Observed) {
    this.sched = sched;
    this.clock = clock;
    this.obs = obs;
    this.player = new DemoWalkPlayer(this.track);
    this.player.reset(clock.t);
  }

  start(onFix: FixListener, onError: LocationErrorListener): Promise<void> {
    this.stop();
    this.timer = this.sched.every(1000, () => {
      if (this.ended) {
        return;
      }
      const tick: DemoTick = this.player.tick(1000 * this.mult, this.hold());
      this.holding = tick.holding;
      this.ended = tick.ended;
      this.trackMs = this.track.fixes[tick.index].tRelMs;
      const f: Fix = tick.fix;
      f.timestampMs = this.clock.t;
      this.obs.probe(this.probe.accept(f), this.trackMs);
      onFix(f);
    });
    return Promise.resolve();
  }

  stop(): void {
    if (this.timer >= 0) {
      this.sched.cancel(this.timer);
      this.timer = -1;
    }
  }

  isRunning(): boolean {
    return this.timer >= 0;
  }

  setSpeed(mult: number): void {
    this.mult = mult;
  }

  jumpToNextStop(): void {
    this.player.jumpToNextStop();
  }

  setHoldPredicate(p: () => boolean): void {
    this.hold = p;
  }

  isHolding(): boolean {
    return this.holding;
  }

  rewind(): void {
    this.player.reset(this.clock.t);
    this.ended = false;
  }
}

class ControllerReplay {
  readonly obs: Observed = new Observed();
  readonly clock: ManualClock = new ManualClock();
  readonly sched: ManualScheduler;
  readonly log: RecordingLog;
  readonly demo: ReplayDemoSource;
  readonly ctrl: TourController;
  seconds: number = 0;

  constructor() {
    this.sched = new ManualScheduler(this.clock);
    this.log = new RecordingLog(this.obs);
    this.demo = new ReplayDemoSource(this.sched, this.clock, this.obs);
    this.log.trackMs = () => this.demo.trackMs;
    const deps: TourControllerDeps = {
      pack: new ReplayPack(), speech: new ReplaySpeech(this.sched, this.obs), voice: new ReplayVoice(), log: this.log,
      clock: this.clock, scheduler: this.sched,
      sourceFor: (kind: FixSource): LocationSource | undefined => kind === FixSource.DEMO ? this.demo : undefined,
      demoControls: (): DemoControls | undefined => this.demo,
      background: (): BackgroundPort | undefined => undefined,
      media: (): MediaSessionPort | undefined => undefined,
      notifier: (): NotifierPort | undefined => undefined,
      haptics: (): HapticsPort | undefined => undefined,
      permissions: (): PermissionPort | undefined => undefined
    };
    this.ctrl = new TourController(deps);
  }

  /** Runs one wall second at a time until the controller tore the tour down (or MAX_STEPS). */
  walk(): void {
    for (this.seconds = 0; this.seconds < MAX_STEPS && this.ctrl.isRunning(); this.seconds++) {
      this.sched.advance(1000);
      const s: EngineSnapshot = this.ctrl.current();
      if (s.offRoute) {
        this.obs.offRouteSnapshots++;
      }
      if (s.platform.demoHold) {
        this.obs.demoHoldSeen = true;
      }
    }
    this.obs.checkSentences();
  }

  statusOf(id: string): StopStatus | undefined {
    const p: StopProgress | undefined = this.ctrl.current().stops.find((s: StopProgress) => s.poiId === id);
    return p === undefined ? undefined : p.status;
  }
}

/** Index of the last matched log line if every [code, part] appears in this order; -1 if one is missing. */
function inOrder(obs: Observed, steps: string[][]): number {
  let at: number = -1;
  for (const s of steps) {
    let found: number = -1;
    for (let i = at + 1; i < obs.logs.length; i++) {
      if (obs.logs[i].code === s[0] && obs.logs[i].kv.indexOf(s[1]) >= 0) {
        found = i;
        break;
      }
    }
    if (found < 0) {
      return -1;
    }
    at = found;
  }
  return at;
}

export default function replayTest() {
  describe('Replay', () => {
    it('fixture_and_plan: DemoTrackMini is simulated, Held-Karp plans stops 7-11 in walking order', 0, () => {
      const t: DemoTrack = demoTrackMini();
      expect(t.simulated).assertTrue();
      expect(t.fixes.length > 1000).assertTrue();
      expect(DEMO_MINI_STOPS.length).assertEqual(5);
      expect(DEMO_MINI_STOPS.filter((s: MiniStop) => s.mode === 'passBy').map((s: MiniStop) => s.n).join(','))
        .assertEqual(`${PASS_BY_STOP}`);
      // the accuracy dip really is above the 40 m trigger limit
      const dip: MiniEvent = eventOf('poorAccuracy');
      const inDip: DemoFix[] = t.fixes.filter((f: DemoFix) => f.tRelMs >= dip.fromMs && f.tRelMs <= dip.toMs);
      expect(inDip.length > 0).assertTrue();
      expect(inDip.every((f: DemoFix) => f.accuracyM > 40)).assertTrue();
      const p: TourPlan = heldKarpPlan();
      expect(p.algo).assertEqual('heldkarp');
      expect(p.order.join(',')).assertEqual(stopIds().join(','));
    });

    it('voice_x1: track-time replay through FixFilter + TourEngine gives the jury outcomes', 0, () => {
      const r: EngineReplay = new EngineReplay(false, 1, true).run();
      console.info(r.summary('engine-voice-x1'));
      assertJuryOutcomes(r.obs, (id: string) => r.statusOf(id));
      assertWalkingPaceLinger(r.obs);
      expect(r.st.phase).assertEqual(TourPhase.FINISHED);
      expect(r.idle()).assertTrue();
      // the finish lines are the last thing heard
      const starts: LogLine[] = r.obs.lines('STORY_START');
      expect(r.obs.heard[r.obs.heard.length - 1].itemId).assertEqual(kvOf(starts[starts.length - 1].kv, 'id'));
    });

    it('voice_x8: wall-clock stamps at x8 (the emulator demo setting) keep the same outcomes', 0, () => {
      const r: EngineReplay = new EngineReplay(false, 8, false).run();
      console.info(r.summary('engine-voice-x8'));
      assertJuryOutcomes(r.obs, (id: string) => r.statusOf(id));
      expect(r.st.phase).assertEqual(TourPhase.FINISHED);
    });

    it('voice_x4: wall-clock stamps at x4 (the other demo speed) keep the same outcomes', 0, () => {
      const r: EngineReplay = new EngineReplay(false, 4, false).run();
      console.info(r.summary('engine-voice-x4'));
      assertJuryOutcomes(r.obs, (id: string) => r.statusOf(id));
      expect(r.st.phase).assertEqual(TourPhase.FINISHED);
    });

    it('text_only_x1: no SPEAK at all, captions paced by TICK, same outcomes', 0, () => {
      const r: EngineReplay = new EngineReplay(true, 1, true).run();
      console.info(r.summary('engine-text-x1'));
      assertJuryOutcomes(r.obs, (id: string) => r.statusOf(id));
      assertWalkingPaceLinger(r.obs);
      expect(r.st.phase).assertEqual(TourPhase.FINISHED);
      expect(r.inFlight === undefined).assertTrue();
      expect(r.obs.count('STORY_START', 'mode=text')).assertEqual(r.obs.lines('STORY_START').length);
      expect(r.obs.count('STORY_START', 'mode=voice')).assertEqual(0);
    });

    it('deterministic: two replays produce the identical log', 0, () => {
      const a: EngineReplay = new EngineReplay(false, 1, true).run();
      // Same plan object: TourPlan.ms is the planner's wall-clock run time (logged in ROUTE_PLAN), 0 or 1 ms
      // depending on machine load, which made this case flaky. The engine replay itself must be identical.
      const b: EngineReplay = new EngineReplay(false, 1, true);
      b.plan = a.plan;
      b.run();
      const text = (r: EngineReplay): string => r.obs.logs.map((l: LogLine) => `${l.code} ${l.kv}`).join('\n');
      expect(a.obs.logs.length > 50).assertTrue();
      expect(text(a)).assertEqual(text(b));
    });

    it('controller_x8: TourController + demo source at x8, logs in smoke order, same outcomes', 0,
      async (done: Function) => {
        const r: ControllerReplay = new ControllerReplay();
        await r.ctrl.setSource(FixSource.DEMO);
        const p: TourPlan = await r.ctrl.plan(TOUR_ID, 0);
        expect(p.algo).assertEqual('heldkarp');
        r.ctrl.setDemoSpeed(8);
        await r.ctrl.start();
        expect(r.ctrl.isRunning()).assertTrue();
        r.walk();
        console.info(r.obs.summary('controller-voice-x8', r.ctrl.current().phase === TourPhase.FINISHED, r.seconds));
        expect(r.ctrl.isRunning()).assertFalse();
        expect(r.ctrl.current().phase).assertEqual(TourPhase.FINISHED);
        assertJuryOutcomes(r.obs, (id: string) => r.statusOf(id));
        // the order scripts/smoke.sh greps for on the emulator
        const steps: string[][] = [['PACK_LOAD', 'pois=5'], ['ROUTE_PLAN', 'algo=heldkarp'], ['LOC_SOURCE', 'kind=demo']];
        for (const id of stopIds()) {
          steps.push(['POI_ENTER', `id=${id}`]);
          steps.push(['STORY_START', `poi=${id}`]);
        }
        steps.push(['STATE', 'to=finished']);
        steps.push(['STATE', 'ev=TEARDOWN why=finished']);
        expect(inOrder(r.obs, steps) >= 0).assertTrue();
        expect(r.obs.demoHoldSeen).assertTrue();                // "Demo assist" held the walker during a story
        expect(r.obs.lines('UNCAUGHT').length).assertEqual(0);
        expect(r.obs.lines('LOC_NOFIX').length).assertEqual(0);
        expect(r.sched.count()).assertEqual(0);                  // nothing left running after the finish
        done();
      });
  });
}
